# Copiá este archivo a .env.local y completá los valores.
# .env.local NUNCA se commitea: está en .gitignore.

# Panel de Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública del sitio. En local dejalo así; en Vercel poné el dominio real.
# Se usa para armar el destino del link mágico.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zona horaria de la operación. Todo se guarda en UTC.
NEXT_PUBLIC_TIME_ZONE=America/Santiago

# ATENCIÓN: la service_role key NO va acá ni en ningún archivo del repositorio.
# Saltea todas las políticas de seguridad. Si alguna vez hace falta, va como
# variable de entorno del servidor en Vercel, nunca con prefijo NEXT_PUBLIC_.
