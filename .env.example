# Copiá este archivo a .env.local y completá los valores.
# .env.local NUNCA se commitea: está en .gitignore.

# Panel de Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública del sitio. En local dejalo así; en Vercel poné el dominio real.
# Se usa para armar el destino del link mágico.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zona horaria de la operación. Todo se guarda en UTC.
NEXT_PUBLIC_TIME_ZONE=America/Santiago

# --- Resumen diario por correo (opcional) -----------------------------------
#
# Todo lo de acá abajo es SOLO DE SERVIDOR. Nada lleva el prefijo NEXT_PUBLIC_,
# así que nada de esto puede terminar en el navegador. Se cargan en Vercel, en
# Settings → Environment Variables, no en este archivo.
#
# Sin estas variables la aplicación funciona igual: los avisos de rescate
# siguen apareciendo dentro de la app. Lo único que no pasa es el correo.

# Cadena aleatoria de 16 caracteres o más. Vercel la manda como
# `Authorization: Bearer <valor>` en cada corrida del cron. Sin esto, la ruta
# del resumen se niega a responder.
# CRON_SECRET=

# Panel de Supabase → Settings → API → service_role.
# SALTEA TODAS LAS POLÍTICAS DE SEGURIDAD. Va únicamente en Vercel y solo la usa
# la ruta del resumen, que corre sin ninguna persona detrás. NUNCA en este
# archivo, nunca en el repositorio, nunca con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de resend.com. Sin esto el resumen se arma igual y queda en los
# registros de Vercel, pero no se envía.
# RESEND_API_KEY=
# RESUMEN_FROM=relevo@tudominio.cl
# RESUMEN_TO=supervisor@tuempresa.cl,otro@tuempresa.cl
